extends ../layout

block content
  h2 Editar Cuenta Corriente

  .card
    if cuenta.cliente
      p
        strong Cliente:
        | #{cuenta.cliente.nombre} #{cuenta.cliente.apellido} (CUIT: #{cuenta.cliente.cuit})

    p
      strong Saldo Actual:
      | $#{cuenta.saldo.toFixed(2)}

    form(method="POST", action="/cuentas/vista/cargo")
      h3 Registrar Carga
      input(type="hidden", name="cuentaId", value=cuenta._id)

      label Monto:
      input(type="number", name="monto", step="0.01", required)
      br
      br

      label Descripción:
      input(type="text", name="descripcion")
      br
      br

      button(type="submit") Registrar Carga

    hr

    form(method="POST", action="/cuentas/vista/pago")
      h3 Registrar Pago
      input(type="hidden", name="cuentaId", value=cuenta._id)

      label Monto:
      input(type="number", name="monto", step="0.01", required)
      br
      br

      button(type="submit", style="background-color: green;") Registrar Pago

  a.btn(href="/cuentas/vista") Volver
