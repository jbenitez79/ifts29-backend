extends ../layout

block content
  h2 Nueva Cuenta Corriente

  form(method="POST", action="/cuentas/vista/nuevo")

    label Cliente:
    select(name="idCliente", required)
      option(value="") Seleccionar cliente...
      each cliente in clientes
        option(value=cliente._id) #{cliente.nombre} #{cliente.apellido} - CUIT: #{cliente.cuit}
    br
    br

    label Límite de Crédito:
    input(type="number", name="limiteCredito", value="150000", required)
    br
    br

    button(type="submit") Crear Cuenta

  a(href="/cuentas/vista") Volver
