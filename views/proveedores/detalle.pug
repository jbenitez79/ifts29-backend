extends ../layout

block content
  h2 Detalle del Proveedor

  .card
    p
      strong ID:
      | #{proveedor._id}
    p
      strong Nombre:
      | #{proveedor.nombre}
    p
      strong CUIT:
      | #{proveedor.cuit}
    p
      strong Teléfono:
      | #{proveedor.telefono}
    p
      strong Email:
      | #{proveedor.email}
    p
      strong Domicilio:
      | #{proveedor.domicilio}
    p
      strong Localidad:
      | #{proveedor.localidad}
    p
      strong Provincia:
      | #{proveedor.provincia}
    p
      strong País:
      | #{proveedor.pais}
    p
      strong Rubro:
      | #{proveedor.rubro}
    p
      strong Condición de Pago:
      | #{proveedor.condicionDePago}
    p
      strong Activo:
      | #{proveedor.activo ? 'Sí' : 'No'}

  a.btn(href="/proveedores/vista") Volver
