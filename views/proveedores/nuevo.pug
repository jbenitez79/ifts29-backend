extends ../layout

block content
  h2 Nuevo Proveedor

  form(method="POST", action="/proveedores/vista/nuevo")

    label Nombre:
    input(type="text", name="nombre", required)
    br
    br

    label CUIT:
    input(type="text", name="cuit", required)
    br
    br

    label Teléfono:
    input(type="text", name="telefono", required)
    br
    br

    label Email:
    input(type="email", name="email", required)
    br
    br

    label Domicilio:
    input(type="text", name="domicilio", required)
    br
    br

    label Localidad:
    input(type="text", name="localidad", required)
    br
    br

    label Provincia:
    input(type="text", name="provincia", required)
    br
    br

    label País:
    input(type="text", name="pais", required)
    br
    br

    label Rubro:
    input(type="text", name="rubro", required)
    br
    br

    label Condición de Pago:
    select(name="condicionDePago", required)
      option(value="") Seleccionar...
      option(value="contado") Contado
      option(value="débito") Débito
      option(value="crédito") Crédito
    br
    br

    label Activo:
    input(type="checkbox", name="activo", value="true", checked)
    br
    br

    button(type="submit") Guardar

  a(href="/proveedores/vista") Volver
