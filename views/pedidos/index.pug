extends ../layout

block content
  h2 Lista de Pedidos

  a.btn(href="/pedidos/vista/nuevo") + Nuevo Pedido

  table
    thead
      tr
        th ID
        th Fecha
        th CUIT Cliente
        th Cliente
        th Estado
        th Items
        th Total
        th Acciones
    tbody
      each pedido in pedidos
        tr
          td= pedido._id
          td= pedido.fecha ? pedido.fecha.toLocaleDateString('es-AR') : ''
          td= pedido.cliente ? pedido.cliente.cuit : ''
          td= pedido.cliente ? pedido.cliente.nombre + ' ' + pedido.cliente.apellido : 'Cliente desconocido'
          td
            span(style=`padding: 0.25rem 0.5rem; border-radius: 0.25rem; background-color: ${pedido.estado === 'pendiente' ? '#fef3c7' : pedido.estado === 'aprobado' ? '#d1fae5' : pedido.estado === 'cancelado' ? '#fee2e2' : '#e0e7ff'}; color: ${pedido.estado === 'pendiente' ? '#92400e' : pedido.estado === 'aprobado' ? '#065f46' : pedido.estado === 'cancelado' ? '#991b1b' : '#3730a3'};`)
              = pedido.estado
          td= pedido.productos ? pedido.productos.length : 0
          td= "$" + pedido.total
          td
            a(href=`/pedidos/vista/detalle/${pedido._id}`) Ver
            |  | 
            a(href=`/pedidos/vista/editar/${pedido._id}`) Editar
            |  | 
            a(href=`/pedidos/vista/eliminar/${pedido._id}`, style="color: red;") Eliminar
